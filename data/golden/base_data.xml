<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Base Golden Data — shared across all scenario files -->
    <record id="golden_partner_hoymiles" model="res.partner">
        <field name="name">HOYMILES B.V.</field>
        <field name="is_company">True</field>
    </record>
    <record id="golden_partner_dhl" model="res.partner">
        <field name="name">DHL Freight NL</field>
        <field name="is_company">True</field>
        <field name="is_carrier">True</field>
    </record>
    <record id="golden_wh_rotterdam" model="stock.warehouse">
        <field name="name">Rotterdam Warehouse</field>
        <field name="code">RTM</field>
    </record>
    <record id="golden_wh_denhaag" model="stock.warehouse">
        <field name="name">Den Haag Warehouse</field>
        <field name="code">HAG</field>
    </record>
    <record id="golden_type_40hq" model="tlmp.transport.type">
        <field name="name">Port to Warehouse</field>
        <field name="code">port_to_warehouse</field>
        <field name="category">ftl</field>
        <field name="mode">road</field>
    </record>
    <record id="golden_charge_freight" model="tlmp.carrier.charge.type">
        <field name="code">FREIGHT_BASE</field>
        <field name="name">Freight Base</field>
        <field name="main_category">transport</field>
    </record>
</odoo>